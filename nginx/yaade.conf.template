server_tokens off;

js_engine qjs;
js_import login_guard from /etc/nginx/login-guard.js;
js_shared_dict_zone zone=login_windows:2m timeout=10m evict;
js_shared_dict_zone zone=login_failures:2m type=number timeout=10m evict;
js_shared_dict_zone zone=login_blocks:2m type=number timeout=15m evict;
js_var $login_response_body "";
js_var $login_blocked_until "";

log_format login_block escape=json
    '{"time":"$time_iso8601","ip":"$remote_addr",'
    '"event":"login_blocked","blocked_until":"$login_blocked_until"}';
access_log /var/log/nginx/yaade/login-blocks.log login_block if=$login_blocked_until;

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

upstream yaade_backend {
    zone yaade_backend 64k;
    resolver 127.0.0.11 valid=10s ipv6=off;
    server yaade:9339 resolve;
}

server {
    listen 80 default_server;
    server_name _;

    return 308 https://$host:${YAADE_HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    server_name _;

    ssl_certificate /etc/nginx/tls/yaade.crt;
    ssl_certificate_key /etc/nginx/tls/yaade.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    error_page 497 =308 https://$host:${YAADE_HTTPS_PORT}$request_uri;

    client_max_body_size 10m;

    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_cookie_flags vertx-web.session secure httponly;

    location ~ ^/api/login/?$ {
        js_access login_guard.checkBlock;
        js_header_filter login_guard.resetOnSuccess;
        js_body_filter login_guard.inspectResponse buffer_type=buffer;
        proxy_pass http://yaade_backend;
    }

    location / {
        proxy_pass http://yaade_backend;
    }
}
