# Начальный логин администратора при создании базы Yaade.
YAADE_ADMIN_USERNAME=admin

# Обязательный временный пароль для новых локальных учётных записей и сброса пароля.
# Сгенерируйте значение командой openssl rand -hex 24. Смените пароль при первом входе.
YAADE_DEFAULT_PASSWORD=

# IP-адрес, на котором Nginx принимает подключения. 127.0.0.1 доступен только локально.
# Для доступа команды укажите IP сетевого интерфейса сервера.
YAADE_BIND_IP=127.0.0.1

# Внешний порт HTTP. Nginx перенаправляет запросы на HTTPS.
# Значение 80 позволяет открывать HTTP-адрес без явного указания порта.
YAADE_HTTP_PORT=9339

# Внешний порт HTTPS и целевой порт перенаправления.
YAADE_HTTPS_PORT=9443

# Имена DNS и IP-адреса в сертификате задаются в оболочке перед запуском OpenSSL.
# export YAADE_TLS_SAN='DNS:localhost,IP:127.0.0.1,DNS:yaade.example.org,IP:192.168.1.10'
